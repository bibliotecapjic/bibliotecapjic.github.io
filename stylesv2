/* ==================================================================
   HOJA DE ESTILOS - SISTEMA DE MAPA DE UBICACIÓN DE LIBROS
   ==================================================================
   VERSIÓN: 3.0 - Paleta base definida por el usuario
   
   PALETA PRINCIPAL (4 colores base):
   ---------------------------------------------------------------
   #165a72  → Azul petróleo oscuro (fondo de header, títulos, énfasis)
   #edd91d  → Amarillo mostaza (botones de materiales, bordes de advertencia, leyenda)
   #53738c  → Gris azulado (textos secundarios, bordes por defecto)
   #00B4AB  → Turquesa (interacciones, focus, éxito, marcadores)
   ---------------------------------------------------------------
   
   Todos los demás colores derivan de estos o son neutros
   (blancos, negros, grises, rojos de error).
   ================================================================== */

/* ==================================================================
   1. PALETA DE COLORES (variables CSS globales)
   ================================================================== */
:root {
    /* ========== 1.1 LOS CUATRO COLORES PRINCIPALES ========== */
    --color-primario-oscuro: #165a72;   /* Azul petróleo. Base para cabeceras, títulos */
    --color-amarillo: #edd91d;          /* Amarillo mostaza. Acentos secundarios, warning */
    --color-gris-azulado: #53738c;      /* Gris azulado. Textos secundarios, bordes */
    --color-turquesa: #00B4AB;          /* Turquesa. Interacciones, focus, éxito */
    
    /* ========== 1.2 Colores base neutros ========== */
    --blanco: #ffffff;
    --negro: #000000;
    
    /* ========== 1.3 Fondos de áreas principales ========== */
    --fondo-pagina: #f0f4f9;            /* Derivado del gris azulado muy claro */
    --fondo-tarjeta: var(--blanco);
    --fondo-seleccion: #f8f9fa;
    --fondo-location: #e0f4f2;          /* Derivado de turquesa muy claro */
    --fondo-loading: #f8f9fa;
    --fondo-material-hover: #fef8e0;    /* Derivado del amarillo muy claro */
    --fondo-material-selected: #fff3cd;
    --fondo-error: #fdecea;             /* Neutro rojo claro */
    --fondo-warning: #fff3cd;           /* Derivado del amarillo */
    --fondo-success: #e0f4f2;           /* Derivado del turquesa */
    
    /* ========== 1.4 Colores de texto ========== */
    --texto-principal: #1a2c3a;         /* Oscuro, basado en el azul petróleo */
    --texto-secundario: var(--color-gris-azulado);  /* #53738c */
    --texto-ayuda: #6c7e8f;
    --texto-boton: var(--color-gris-azulado);
    --texto-material-selected: #856404; /* Derivado del amarillo oscuro */
    --texto-error: #c0392b;
    --texto-warning: #856404;
    --texto-success: var(--color-turquesa);
    --texto-placeholder: #9aaebf;
    --texto-loading: #6c7e8f;
    --texto-no-map: #2c4b5e;
    
    /* ========== 1.5 Bordes ========== */
    --borde-default: #cbdde6;           /* Basado en gris azulado claro */
    --borde-claro: #e2edf2;
    --borde-muy-claro: #e2edf2;
    --borde-focus: var(--color-turquesa);   /* #00B4AB */
    --borde-error: #e74c3c;
    --borde-warning: var(--color-amarillo); /* #edd91d */
    --borde-success: var(--color-turquesa);
    --borde-location: var(--color-turquesa);
    --borde-legend: var(--color-amarillo);
    
    /* ========== 1.6 Acentos temáticos (alias) ========== */
    --azul-oscuro: var(--color-primario-oscuro);   /* #165a72 */
    --azul-principal: var(--color-turquesa);       /* #00B4AB */
    --azul-gradiente-claro: #1e6f8a;               /* Variante más clara del azul petróleo */
    --naranja: var(--color-amarillo);              /* Se usa amarillo en lugar de naranja */
    --rojo: #e74c3c;
    --verde: var(--color-turquesa);
    --amarillo-marcador: rgba(237, 217, 29, 0.7);  /* Amarillo semitransparente */
    
    /* ========== 1.7 Sombras ========== */
    --sombra-suave: rgba(0, 0, 0, 0.08);
    --sombra-media: rgba(0, 0, 0, 0.1);
    --sombra-foco: rgba(0, 180, 171, 0.2);        /* Turquesa transparente */
    --sombra-marcador: rgba(0, 180, 171, 0.8);
    
    /* ========== 1.8 Estados deshabilitados ========== */
    --fondo-disabled: #f5f5f5;
    --texto-disabled-opacity: 0.6;
    
    /* ========== 1.9 Spinner ========== */
    --spinner-borde: #f3f3f3;
    --spinner-borde-top: var(--color-turquesa);
}

/* ==================================================================
   2. RESET Y ESTILOS BASE
   ================================================================== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: var(--fondo-pagina);
    color: var(--texto-principal);
    padding: 20px;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
}

/* ==================================================================
   3. CABECERA (HEADER)
   ==================================================================
   Usa el gradiente de azul petróleo (#165a72) a una variante más clara.
   ================================================================== */
.header {
    background: linear-gradient(135deg, var(--azul-oscuro), var(--azul-gradiente-claro));
    color: var(--blanco);
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 20px;
    box-shadow: 0 4px 12px var(--sombra-media);
}

h1 {
    font-size: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.subtitle {
    font-size: 16px;
    opacity: 0.9;
    margin-top: 5px;
}

/* ==================================================================
   4. ESTRUCTURA PRINCIPAL (GRID 2 COLUMNAS)
   ================================================================== */
.main-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 25px;
}

@media (max-width: 900px) {
    .main-content {
        grid-template-columns: 1fr;
    }
}

/* ==================================================================
   5. PANEL DE CONTROLES (COLUMNA IZQUIERDA)
   ================================================================== */
.controls-panel {
    background: var(--fondo-tarjeta);
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 4px 12px var(--sombra-suave);
}

/* ---------- 5.1 Sección de bibliotecas / libros ---------- */
.library-section {
    margin-bottom: 30px;
}

.section-title {
    font-size: 18px;
    color: var(--azul-oscuro);           /* #165a72 */
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--borde-claro);
    display: flex;
    align-items: center;
    gap: 10px;
}

.library-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
}

.library-btn {
    padding: 16px;
    background: var(--fondo-tarjeta);
    border: 2px solid var(--borde-default);
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    color: var(--texto-boton);           /* #53738c */
    cursor: pointer;
    transition: all 0.3s;
    text-align: left;
    display: flex;
    align-items: center;
    gap: 12px;
}

.library-btn:hover {
    border-color: var(--borde-focus);    /* #00B4AB */
    background: var(--fondo-seleccion);
}

.library-btn.selected {
    border-color: var(--borde-focus);    /* #00B4AB */
    background: var(--fondo-seleccion);
    color: var(--azul-oscuro);           /* #165a72 */
}

.library-icon {
    font-size: 22px;
    width: 30px;
}

.divider {
    height: 1px;
    background: var(--borde-muy-claro);
    margin: 25px 0;
    width: 100%;
}

/* ---------- 5.2 Sección de signatura ---------- */
.signature-section {
    margin-bottom: 30px;
}

.signature-title {
    font-size: 18px;
    color: var(--azul-oscuro);
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.required-field::after {
    content: " *";
    color: var(--rojo);
}

.signature-box {
    margin-top: 10px;
}

.signature-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 500;
    color: var(--texto-secundario);      /* #53738c */
    font-size: 14px;
}

.signature-input {
    width: 100%;
    padding: 16px;
    border: 2px solid var(--borde-default);
    border-radius: 8px;
    font-size: 16px;
    font-family: monospace;
    transition: all 0.3s;
}

.signature-input:required {
    border-left: 4px solid var(--borde-focus);  /* #00B4AB */
}

.signature-input:focus {
    outline: none;
    border-color: var(--borde-focus);
    box-shadow: 0 0 0 3px var(--sombra-foco);
}

.signature-input:disabled {
    background-color: var(--fondo-disabled);
    cursor: not-allowed;
    opacity: var(--texto-disabled-opacity);
}

.help-text {
    font-size: 12px;
    color: var(--texto-ayuda);
    margin-top: 5px;
    font-style: italic;
    line-height: 1.5;
}

/* ---------- 5.3 Sección de otros materiales ---------- */
.other-materials-section {
    margin-bottom: 20px;
}

.material-buttons {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 10px;
}

.material-btn {
    padding: 14px 10px;
    background: var(--fondo-tarjeta);
    border: 2px solid var(--borde-default);
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--texto-boton);
    cursor: pointer;
    transition: all 0.3s;
}

.material-btn:hover {
    border-color: var(--naranja);        /* #edd91d */
    background: var(--fondo-material-hover);
}

.material-btn.selected {
    border-color: var(--naranja);        /* #edd91d */
    background: var(--fondo-material-selected);
    color: var(--texto-material-selected);
}

.material-btn:disabled {
    background-color: var(--fondo-disabled);
    cursor: not-allowed;
    opacity: var(--texto-disabled-opacity);
}

/* ==================================================================
   6. PANEL DEL MAPA (COLUMNA DERECHA)
   ================================================================== */
.map-panel {
    background: var(--fondo-tarjeta);
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 4px 12px var(--sombra-suave);
    display: flex;
    flex-direction: column;
}

/* ---------- 6.1 Información de selección ---------- */
.selection-info {
    background: var(--fondo-seleccion);
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    border-left: 4px solid var(--borde-focus);   /* #00B4AB */
}

.selection-info h3 {
    font-size: 16px;
    margin-bottom: 10px;
    color: var(--azul-oscuro);
    display: flex;
    align-items: center;
    gap: 8px;
}

.selection-details {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.detail-item {
    flex: 1;
    min-width: 150px;
}

.detail-label {
    font-size: 12px;
    color: var(--texto-ayuda);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.detail-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--azul-oscuro);
    word-break: break-word;
}

/* ---------- 6.2 Panel de ubicación encontrada ---------- */
.location-info-panel {
    background: var(--fondo-location);
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    display: none;
    border-left: 4px solid var(--borde-location);  /* #00B4AB */
}

.location-info-panel.active {
    display: block;
}

.location-info-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--azul-oscuro);
    display: flex;
    align-items: center;
    gap: 8px;
}

.location-info-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--texto-secundario);
}

/* ---------- 6.3 Contenedor del mapa ---------- */
.map-container {
    flex: 1;
    position: relative;
    background: var(--fondo-seleccion);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--borde-muy-claro);
    min-height: 500px;
    margin-bottom: 20px;
}

.initial-state {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--texto-placeholder);
    font-size: 18px;
    text-align: center;
    padding: 40px;
}

.loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: var(--fondo-loading);
    color: var(--texto-loading);
    font-size: 18px;
    text-align: center;
    padding: 40px;
}

.loading-spinner {
    border: 5px solid var(--spinner-borde);
    border-top: 5px solid var(--spinner-borde-top);  /* #00B4AB */
    border-radius: 50%;
    width: 50px;
    height: 50px;
    animation: spin 2s linear infinite;
    margin: 0 auto 20px;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* ---------- 6.4 Marcadores ---------- */
.map-marker {
    cursor: pointer;
    transition: transform 0.2s ease, filter 0.2s ease;
}

.map-marker:hover {
    transform: scale(1.2);
    filter: drop-shadow(0 0 8px var(--sombra-marcador)); /* turquesa */
}

/* ---------- 6.5 Leyenda ---------- */
.legend-panel {
    background: var(--fondo-tarjeta);
    padding: 12px 15px;
    border-radius: 6px;
    display: none;
    border: 1px solid var(--borde-muy-claro);
}

.legend-panel.active {
    display: flex;
    align-items: center;
    gap: 10px;
}

.legend-color {
    width: 16px;
    height: 16px;
    background: var(--amarillo-marcador);    /* amarillo semitransparente */
    border: 2px solid var(--borde-legend);   /* #edd91d */
    border-radius: 2px;
    flex-shrink: 0;
}

.legend-text {
    font-size: 14px;
    color: var(--texto-secundario);
}

/* ---------- 6.6 Estado sin mapa ---------- */
.no-map-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: linear-gradient(135deg, var(--fondo-seleccion), #e9ecef);
    color: var(--texto-loading);
    font-size: 18px;
    text-align: center;
    padding: 40px;
}

.no-map-state i {
    font-size: 64px;
    margin-bottom: 20px;
    opacity: 0.5;
    color: #adb5bd;
}

.no-map-state h3 {
    font-size: 20px;
    margin-bottom: 10px;
    color: var(--texto-no-map);
}

.no-map-state p {
    font-size: 14px;
    opacity: 0.8;
    max-width: 400px;
    margin: 0 auto;
}

/* ==================================================================
   7. MENSAJES DE RETROALIMENTACIÓN
   ================================================================== */
.message {
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    display: none;
}

.message-error {
    background: var(--fondo-error);
    border-left: 4px solid var(--borde-error);
    color: var(--texto-error);
}

.message-warning {
    background: var(--fondo-warning);
    border-left: 4px solid var(--borde-warning);  /* #edd91d */
    color: var(--texto-warning);
}

.message-success {
    background: var(--fondo-success);
    border-left: 4px solid var(--borde-success);  /* #00B4AB */
    color: var(--texto-success);
}

/* ==================================================================
   8. ACCESIBILIDAD (solo lectores de pantalla)
   ================================================================== */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}



/* ==================== BOTON TAP PARA REGRESAR A PRIMO  ==================== */
.header {
    /* Mantiene el gradiente y padding que ya tenías, pero aseguramos que el contenido interno se distribuya */
    padding: 25px;
}

/* Contenedor flexible para el título y las tabs */
.header > div:first-child {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 0.5rem;
}

/* Estilo del contenedor de tabs */
.primo-tabs {
    display: flex;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 60px;
    padding: 4px;
    backdrop-filter: blur(4px);
}

/* Estilo común para cada tab (activo y enlace) */
.tab-active,
.tab-link {
    padding: 6px 20px;
    border-radius: 60px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
    cursor: default;
}

/* Tab activo (Mapa) */
.tab-active {
    background: white;
    color: var(--azul-oscuro);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

/* Tab enlace (Primo) */
.tab-link {
    color: rgba(255, 255, 255, 0.85);
    background: transparent;
}

.tab-link:hover {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    transform: translateY(-1px);
}

.tab-link {
    cursor: pointer !important;
}

/* Ajuste responsive: en móviles, que las tabs queden alineadas a la izquierda si el título ocupa todo el ancho */
@media (max-width: 640px) {
    .header > div:first-child {
        flex-direction: column;
        align-items: flex-start;
    }
    .primo-tabs {
        align-self: flex-end;
        margin-top: 0.5rem;
    }
}

